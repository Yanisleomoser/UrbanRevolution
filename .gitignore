# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.cache/

# Vercel
.vercel/

# Secrets — never commit tokens (Replicate / Anthropic / Upstash). Use Vercel env.
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
screenshots/

# Coverage (c8) — generated locally / in CI, never committed
coverage/
.nyc_output/

# Transient agent worktrees (auto-created/cleaned by the agent harness)
.claude/worktrees/

# Wegwerf-Messsonden neben den permanenten scripts/verify-*.mjs: ad-hoc
# Playwright-Skripte, mit denen eine Änderung EINMAL am echten Render
# nachgemessen wird (Overlap, Kontrast, Hotspot-Geometrie …). Konvention:
# `*.tmp.mjs` in scripts/, nach Gebrauch löschen. Ins Repo gehören nur die
# dauerhaften Guards — die Sonden würden sonst als Karteileichen liegen
# bleiben und bei Parallel-Läufen den Arbeitsbaum verschmutzen.
scripts/*.tmp.mjs
