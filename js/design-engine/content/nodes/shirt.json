{
  "_comment": "shirt branch — lean journey (B form · C fabric · D colour). Every node gated by category=='shirt' + a confidence check; each maps to a visible GarmentSVG flat parameter. Mirrors jacket.json schema.",
  "nodes": [
    {
      "id": "shirt_subarch",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'shirt' && _confidence.subArchetype < 0.6",
      "priority": 0.9,
      "question": {
        "de": "Welches Hemd?",
        "en": "Which shirt?"
      },
      "choices": [
        {
          "id": "classic",
          "label": {
            "de": "Klassisch",
            "en": "Classic"
          },
          "effects": {
            "set": {
              "subArchetype": "classic",
              "construction.collar": "shirt",
              "construction.closure": "button"
            }
          }
        },
        {
          "id": "overshirt",
          "label": {
            "de": "Overshirt",
            "en": "Overshirt"
          },
          "effects": {
            "set": {
              "subArchetype": "overshirt",
              "length": "regular",
              "construction.pockets": "flap"
            },
            "weight": {
              "utility": 0.2
            }
          }
        },
        {
          "id": "camp",
          "label": {
            "de": "Resort",
            "en": "Camp"
          },
          "effects": {
            "set": {
              "subArchetype": "camp",
              "construction.collar": "notched"
            },
            "weight": {
              "softCouture": 0.1
            }
          }
        },
        {
          "id": "popover",
          "label": {
            "de": "Popover",
            "en": "Popover"
          },
          "effects": {
            "set": {
              "subArchetype": "popover",
              "construction.closure": "none"
            },
            "weight": {
              "quietMinimal": 0.1
            }
          }
        }
      ]
    },
    {
