{
  "_comment": "pants branch — full journey at jacket depth (B form · C fabric+finish · D colour+pattern · E details). Every node gated by category=='pants' + a confidence check; each maps to a visible GarmentSVG flat parameter. Mirrors jacket.json schema.",
  "nodes": [
    {
      "id": "pants_subarch",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'pants' && _confidence.subArchetype < 0.6",
      "priority": 0.9,
      "question": {
        "de": "Welche Hose?",
        "en": "Which trousers?"
      },
      "choices": [
        {
          "id": "tailored",
          "label": {
            "de": "Tailored",
            "en": "Tailored"
          },
          "effects": {
            "set": {
              "subArchetype": "tailored",
              "silhouette.fit": 0.45
            },
            "weight": {
              "softCouture": 0.15
            }
          }
        },
        {
          "id": "slim",
          "label": {
            "de": "Slim",
            "en": "Slim"
          },
          "effects": {
            "set": {
              "subArchetype": "slim",
              "silhouette.fit": 0.12
            }
          }
        },
        {
          "id": "wide",
          "label": {
            "de": "Weit",
            "en": "Wide"
          },
          "effects": {
            "set": {
              "subArchetype": "wide",
              "silhouette.fit": 0.92
            },
            "weight": {
              "y2kStreet": 0.15
            }
          }
        },
        {
          "id": "cargo",
          "label": {
            "de": "Cargo",
            "en": "Cargo"
          },
          "effects": {
            "set": {
              "subArchetype": "cargo",
              "construction.pockets": "cargo"
            },
            "weight": {
              "utility": 0.25
            }
          }
        }
      ]
    },
    {
      "id": "pants_fit",
      "phase": "B",
      "modality": "slider",
      "when": "category == 'pants' && _confidence.silhouette.fit < 0.7",
      "priority": 0.82,
      "question": {
        "de": "Wie weit?",
        "en": "How wide?"
      },
      "bind": "silhouette.fit",
      "axis": {
        "de": [
          "Schmal",
          "Weit"
        ],
        "en": [
          "Slim",
          "Wide"
        ]
      },
      "weightAt": {
        "high": {
          "y2kStreet": 0.15
        }
      }
    },
    {
      "id": "pants_length",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'pants' && _confidence.length < 0.6",
      "priority": 0.7,
      "question": {
        "de": "Wie lang?",
        "en": "How long?"
      },
      "choices": [
        {
          "id": "cropped",
          "label": {
            "de": "7/8",
            "en": "Cropped"
          },
          "effects": {
            "set": {
              "length": "cropped"
            }
          }
        },
        {
          "id": "regular",
          "label": {
            "de": "Voll",
            "en": "Full"
          },
          "effects": {
            "set": {
              "length": "regular"
            }
          }
        },
        {
          "id": "long",
          "label": {
            "de": "Lang/Stack",
            "en": "Stacked"
          },
          "effects": {
            "set": {
              "length": "long"
            },
            "weight": {
              "y2kStreet": 0.1
            }
          }
        }
      ]
    },
    {
      "id": "pants_material",
      "phase": "C",
      "modality": "cards",
      "when": "category == 'pants' && _confidence.fabric.material < 0.6",
      "priority": 0.72,
      "question": {
        "de": "Aus welchem Stoff?",
        "en": "What fabric?"
      },
      "choices": [
        {
          "id": "denim",
          "label": {
            "de": "Denim",
            "en": "Denim"
          },
          "effects": {
            "set": {
              "fabric.material": "denim"
            },
            "weight": {
              "y2kStreet": 0.15
            }
          },
          "image": "/js/design-engine/content/img/material/denim.jpg"
        },
        {
          "id": "cotton",
          "label": {
            "de": "Twill/Chino",
            "en": "Twill"
          },
          "effects": {
            "set": {
              "fabric.material": "cotton"
            },
            "weight": {
              "utility": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/cotton.jpg"
        },
        {
          "id": "wool",
          "label": {
            "de": "Wolle",
            "en": "Wool"
          },
          "effects": {
            "set": {
              "fabric.material": "wool"
            },
            "weight": {
              "softCouture": 0.15
            }
          },
          "image": "/js/design-engine/content/img/material/wool.jpg"
        }
      ]
    },
    {
      "id": "pants_finish",
      "phase": "C",
      "modality": "slider",
      "when": "category == 'pants' && _confidence.fabric.finishWeight < 0.6",
      "priority": 0.5,
      "question": { "de": "Matt oder glänzend?", "en": "Matte or sheen?" },
      "bind": "fabric.finishWeight",
      "axis": { "de": ["Matt", "Glanz"], "en": ["Matte", "Sheen"] },
      "weightAt": { "high": { "softCouture": 0.1, "techAvant": 0.1 } }
    },
    {
      "id": "pants_color",
      "phase": "D",
      "modality": "colorGradient",
      "when": "category == 'pants' && _confidence.color.scheme < 0.7",
      "priority": 0.76,
      "question": {
        "de": "Welche Farbwelt?",
        "en": "Which colourway?"
      }
    },
    {
      "id": "pants_pattern",
      "phase": "D",
      "modality": "cards",
      "when": "category == 'pants' && intent.energy > 0.45 && _confidence.pattern.type < 0.6",
      "priority": 0.52,
      "question": { "de": "Muster?", "en": "Pattern?" },
      "choices": [
        { "id": "none", "label": { "de": "Uni", "en": "Solid" }, "effects": { "set": { "pattern.type": "none" }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "stripe", "label": { "de": "Nadelstreifen", "en": "Pinstripe" }, "effects": { "set": { "pattern.type": "stripe" }, "weight": { "softCouture": 0.1 } } },
        { "id": "check", "label": { "de": "Karo", "en": "Check" }, "effects": { "set": { "pattern.type": "check" }, "weight": { "utility": 0.1 } } },
        { "id": "camo", "label": { "de": "Camo", "en": "Camo" }, "effects": { "set": { "pattern.type": "camo" }, "weight": { "utility": 0.15 } } }
      ]
    },
    {
      "id": "pants_pattern_scale",
      "phase": "D",
      "modality": "slider",
      "when": "category == 'pants' && pattern.type != 'none' && _confidence.pattern.type > 0.5 && _confidence.pattern.scale < 0.6",
      "priority": 0.4,
      "question": { "de": "Wie gross das Muster?", "en": "Pattern scale?" },
      "bind": "pattern.scale",
      "axis": { "de": ["Fein", "Gross"], "en": ["Fine", "Bold"] }
    },
    {
      "id": "pants_details",
      "phase": "E",
      "modality": "regions",
      "when": "category == 'pants'",
      "priority": 0.5,
      "question": { "de": "Die Details — direkt am Stück", "en": "The details — right on the piece" },
      "regions": [
        {
          "id": "waistband",
          "label": { "de": "Bund", "en": "Waistband" },
          "choices": [
            { "id": "belt", "label": { "de": "Gürtelschlaufen", "en": "Belt loops" }, "effects": { "set": { "construction.waistband": "belt" } } },
            { "id": "drawcord", "label": { "de": "Kordelzug", "en": "Drawcord" }, "effects": { "set": { "construction.waistband": "drawcord" }, "weight": { "sport": 0.15 } } },
            { "id": "elastic", "label": { "de": "Elastisch", "en": "Elastic" }, "effects": { "set": { "construction.waistband": "elastic" }, "weight": { "sport": 0.1, "quietMinimal": 0.05 } } }
          ]
        },
        {
          "id": "pockets",
          "label": { "de": "Taschen", "en": "Pockets" },
          "choices": [
            { "id": "side", "label": { "de": "Seitlich", "en": "Side" }, "effects": { "set": { "construction.pockets": "side" } } },
            { "id": "cargo", "label": { "de": "Cargo", "en": "Cargo" }, "effects": { "set": { "construction.pockets": "cargo" }, "weight": { "utility": 0.2 } } },
            { "id": "none", "label": { "de": "Clean", "en": "Clean" }, "effects": { "set": { "construction.pockets": "none" }, "weight": { "quietMinimal": 0.1 } } }
          ]
        },
        {
          "id": "hem",
          "label": { "de": "Beinabschluss", "en": "Leg opening" },
          "choices": [
            { "id": "raw", "label": { "de": "Gerade", "en": "Plain" }, "effects": { "set": { "construction.hem": "straight" } } },
            { "id": "cuffed", "label": { "de": "Umschlag", "en": "Cuffed" }, "effects": { "set": { "construction.hem": "cuffed" }, "weight": { "softCouture": 0.1 } } },
            { "id": "elastic", "label": { "de": "Bündchen", "en": "Elastic" }, "effects": { "set": { "construction.hem": "elastic" }, "weight": { "sport": 0.15 } } }
          ]
        }
      ]
    },
    {
      "id": "pants_signature",
      "phase": "E",
      "modality": "cards",
      "when": "category == 'pants' && intent.energy > 0.5 && _confidence.signature < 0.4",
      "priority": 0.3,
      "question": { "de": "Ein Signature-Detail?", "en": "A signature detail?" },
      "choices": [
        { "id": "none", "label": { "de": "Keins", "en": "None" }, "effects": { "set": { "signature": [] }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "contrast-stitch", "label": { "de": "Kontrastnaht", "en": "Contrast stitch" }, "effects": { "set": { "signature": ["contrast-stitch"] }, "weight": { "utility": 0.1 } } },
        { "id": "branding", "label": { "de": "Branding-Patch", "en": "Branding patch" }, "effects": { "set": { "signature": ["branding-patch"] }, "weight": { "y2kStreet": 0.1, "sport": 0.1 } } }
      ]
    }
  ]
}
