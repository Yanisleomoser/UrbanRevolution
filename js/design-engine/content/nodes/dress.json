{
  "_comment": "dress branch — full journey at jacket depth (B form · C fabric+finish · D colour+pattern · E details). Every node gated by category=='dress' + a confidence check; each maps to a visible GarmentSVG flat parameter. Mirrors jacket.json schema.",
  "nodes": [
    {
      "id": "dress_subarch",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'dress' && _confidence.subArchetype < 0.6",
      "priority": 0.9,
      "question": {
        "de": "Welches Kleid?",
        "en": "Which dress?"
      },
      "choices": [
        {
          "id": "aline",
          "label": {
            "de": "A-Linie",
            "en": "A-line"
          },
          "effects": {
            "set": {
              "subArchetype": "aline",
              "silhouette.fit": 0.3
            },
            "weight": {
              "softCouture": 0.15
            }
          }
        },
        {
          "id": "column",
          "label": {
            "de": "Gerade",
            "en": "Column"
          },
          "effects": {
            "set": {
              "subArchetype": "column",
              "silhouette.fit": 0.7
            },
            "weight": {
              "quietMinimal": 0.15
            }
          }
        },
        {
          "id": "wrap",
          "label": {
            "de": "Wickel",
            "en": "Wrap"
          },
          "effects": {
            "set": {
              "subArchetype": "wrap",
              "construction.collar": "vneck"
            },
            "weight": {
              "softCouture": 0.2
            }
          }
        },
        {
          "id": "slip",
          "label": {
            "de": "Slip",
            "en": "Slip"
          },
          "effects": {
            "set": {
              "subArchetype": "slip",
              "fabric.material": "silk",
              "construction.collar": "vneck",
              "construction.sleeveLength": "sleeveless"
            },
            "weight": {
              "softCouture": 0.15
            }
          }
        }
      ]
    },
    {
      "id": "dress_fit",
      "phase": "B",
      "modality": "slider",
      "when": "category == 'dress' && _confidence.silhouette.fit < 0.7",
      "priority": 0.8,
      "question": {
        "de": "Silhouette?",
        "en": "Silhouette?"
      },
      "bind": "silhouette.fit",
      "axis": {
        "de": [
          "A-Linie",
          "Gerade"
        ],
        "en": [
          "A-line",
          "Column"
        ]
      }
    },
    {
      "id": "dress_length",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'dress' && _confidence.length < 0.6",
      "priority": 0.72,
      "question": {
        "de": "Wie lang?",
        "en": "How long?"
      },
      "choices": [
        {
          "id": "cropped",
          "label": {
            "de": "Mini",
            "en": "Mini"
          },
          "effects": {
            "set": {
              "length": "cropped"
            },
            "weight": {
              "y2kStreet": 0.1
            }
          }
        },
        {
          "id": "regular",
          "label": {
            "de": "Knie/Midi",
            "en": "Knee/Midi"
          },
          "effects": {
            "set": {
              "length": "regular"
            }
          }
        },
        {
          "id": "long",
          "label": {
            "de": "Maxi",
            "en": "Maxi"
          },
          "effects": {
            "set": {
              "length": "long"
            },
            "weight": {
              "softCouture": 0.1
            }
          }
        }
      ]
    },
    {
      "id": "dress_material",
      "phase": "C",
      "modality": "cards",
      "when": "category == 'dress' && _confidence.fabric.material < 0.6",
      "priority": 0.72,
      "question": {
        "de": "Aus welchem Stoff?",
        "en": "What fabric?"
      },
      "choices": [
        {
          "id": "silk",
          "label": {
            "de": "Seide",
            "en": "Silk"
          },
          "effects": {
            "set": {
              "fabric.material": "silk",
              "fabric.finish": "sheen"
            },
            "weight": {
              "softCouture": 0.2
            }
          },
          "image": "/js/design-engine/content/img/material/silk.jpg"
        },
        {
          "id": "cotton",
          "label": {
            "de": "Baumwolle",
            "en": "Cotton"
          },
          "effects": {
            "set": {
              "fabric.material": "cotton"
            }
          },
          "image": "/js/design-engine/content/img/material/cotton.jpg"
        },
        {
          "id": "linen",
          "label": {
            "de": "Leinen",
            "en": "Linen"
          },
          "effects": {
            "set": {
              "fabric.material": "linen"
            },
            "weight": {
              "quietMinimal": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/linen.jpg"
        },
        {
          "id": "wool",
          "label": {
            "de": "Feinstrick",
            "en": "Fine knit"
          },
          "effects": {
            "set": {
              "fabric.material": "wool"
            },
            "weight": {
              "quietMinimal": 0.1,
              "softCouture": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/wool.jpg"
        },
        {
          "id": "denim",
          "label": {
            "de": "Denim",
            "en": "Denim"
          },
          "effects": {
            "set": {
              "fabric.material": "denim"
            },
            "weight": {
              "y2kStreet": 0.15,
              "utility": 0.05
            }
          },
          "image": "/js/design-engine/content/img/material/denim.jpg"
        }
      ]
    },
    {
      "id": "dress_details",
      "_comment": "Detail-Atelier fürs Kleid (Slice-8-Muster): Ausschnitt/Ärmel/Taille wortgleich aus den früheren Karten-Nodes — Hotspots direkt am Stück, Unberührtes bleibt für die Inferenz offen. Slip/Wrap-Vorentscheide erscheinen als „aktuell“ im Picker.",
      "phase": "E",
      "modality": "regions",
      "when": "category == 'dress'",
      "priority": 0.6,
      "question": { "de": "Die Details — direkt am Stück", "en": "The details — right on the piece" },
      "regions": [
        {
          "id": "collar",
          "label": { "de": "Ausschnitt", "en": "Neckline" },
          "choices": [
            { "id": "vneck", "label": { "de": "V-Ausschnitt", "en": "V-neck" }, "effects": { "set": { "construction.collar": "vneck" }, "weight": { "softCouture": 0.1 } } },
            { "id": "crew", "label": { "de": "Rund", "en": "Round" }, "effects": { "set": { "construction.collar": "crew" } } },
            { "id": "stand", "label": { "de": "Hoch", "en": "High" }, "effects": { "set": { "construction.collar": "stand" }, "weight": { "techAvant": 0.1 } } }
          ]
        },
        {
          "id": "sleeve",
          "label": { "de": "Ärmel", "en": "Sleeves" },
          "crop": { "w": 158, "h": 122 },
          "choices": [
            { "id": "sleeveless", "label": { "de": "Ärmellos", "en": "Sleeveless" }, "effects": { "set": { "construction.sleeveLength": "sleeveless" }, "weight": { "softCouture": 0.1 } } },
            { "id": "cap", "label": { "de": "Cap", "en": "Cap" }, "effects": { "set": { "construction.sleeveLength": "cap" } } },
            { "id": "short", "label": { "de": "Kurz", "en": "Short" }, "effects": { "set": { "construction.sleeveLength": "short" } } },
            { "id": "long", "label": { "de": "Lang", "en": "Long" }, "effects": { "set": { "construction.sleeveLength": "long" }, "weight": { "quietMinimal": 0.1 } } }
          ]
        },
        {
          "id": "waist",
          "label": { "de": "Taille", "en": "Waist" },
          "choices": [
            { "id": "fitted", "label": { "de": "Betont", "en": "Fitted" }, "effects": { "set": { "construction.waist": "fitted" }, "weight": { "softCouture": 0.15 } } },
            { "id": "natural", "label": { "de": "Natürlich", "en": "Natural" }, "effects": { "set": { "construction.waist": "natural" } } },
            { "id": "relaxed", "label": { "de": "Fliessend", "en": "Relaxed" }, "effects": { "set": { "construction.waist": "relaxed" }, "weight": { "quietMinimal": 0.1 } } }
          ]
        },
        {
          "id": "closure",
          "label": { "de": "Verschluss", "en": "Closure" },
          "when": "subArchetype != 'wrap' && subArchetype != 'slip'",
          "choices": [
            { "id": "none", "label": { "de": "Ohne Leiste", "en": "No placket" }, "effects": { "set": { "construction.closure": "none" } } },
            { "id": "button", "label": { "de": "Durchgeknöpft", "en": "Button-through" }, "effects": { "set": { "construction.closure": "button" }, "weight": { "quietMinimal": 0.1, "softCouture": 0.1 } } }
          ]
        }
      ]
    },
    {
      "id": "dress_finish",
      "phase": "C",
      "modality": "slider",
      "when": "category == 'dress' && _confidence.fabric.finishWeight < 0.6",
      "priority": 0.5,
      "question": { "de": "Matt oder glänzend?", "en": "Matte or sheen?" },
      "bind": "fabric.finishWeight",
      "axis": { "de": ["Matt", "Glanz"], "en": ["Matte", "Sheen"] },
      "weightAt": { "high": { "softCouture": 0.15 } }
    },
    {
      "id": "dress_color",
      "phase": "D",
      "modality": "colorGradient",
      "when": "category == 'dress' && _confidence.color.scheme < 0.7",
      "priority": 0.78,
      "question": {
        "de": "Welche Farbwelt?",
        "en": "Which colourway?"
      }
    },
    {
      "id": "dress_pattern",
      "phase": "D",
      "modality": "cards",
      "when": "category == 'dress' && intent.energy > 0.45 && _confidence.pattern.type < 0.6",
      "priority": 0.5,
      "question": {
        "de": "Muster?",
        "en": "Pattern?"
      },
      "choices": [
        {
          "id": "none",
          "label": {
            "de": "Uni",
            "en": "Solid"
          },
          "effects": {
            "set": {
              "pattern.type": "none"
            },
            "weight": {
              "quietMinimal": 0.1
            }
          }
        },
        {
          "id": "floral",
          "label": {
            "de": "Floral",
            "en": "Floral"
          },
          "effects": {
            "set": {
              "pattern.type": "abstract"
            },
            "weight": {
              "softCouture": 0.15
            }
          }
        },
        {
          "id": "stripe",
          "label": {
            "de": "Streifen",
            "en": "Stripe"
          },
          "effects": {
            "set": {
              "pattern.type": "stripe"
            }
          }
        }
      ]
    },
    {
      "id": "dress_pattern_scale",
      "phase": "D",
      "modality": "slider",
      "when": "category == 'dress' && pattern.type != 'none' && _confidence.pattern.type > 0.5 && _confidence.pattern.scale < 0.6",
      "priority": 0.4,
      "question": { "de": "Wie gross das Muster?", "en": "Pattern scale?" },
      "bind": "pattern.scale",
      "axis": { "de": ["Fein", "Gross"], "en": ["Fine", "Bold"] }
    },
    {
      "id": "dress_signature",
      "phase": "E",
      "modality": "cards",
      "when": "category == 'dress' && intent.energy > 0.5 && _confidence.signature < 0.4",
      "priority": 0.3,
      "multi": true,
      "question": { "de": "Signature-Details? Stapelbar.", "en": "Signature details? Stackable." },
      "choices": [
        { "id": "none", "exclusive": true, "label": { "de": "Keins", "en": "None" }, "effects": { "set": { "signature": [] }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "side-slit", "label": { "de": "Seitenschlitz", "en": "Side slit" }, "effects": { "set": { "signature": ["side-slit"] }, "weight": { "softCouture": 0.15 } } },
        { "id": "contrast-stitch", "label": { "de": "Kontrastnaht", "en": "Contrast stitch" }, "effects": { "set": { "signature": ["contrast-stitch"] }, "weight": { "techAvant": 0.1 } } }
      ]
    }
  ]
}
