{
  "_comment": "hoodie branch — full journey at jacket depth (B form · C fabric · D colour+pattern · E details). Every node gated by category=='hoodie' + a confidence check; each maps to a visible GarmentSVG flat parameter. Mirrors jacket.json schema.",
  "nodes": [
    {
      "id": "hoodie_start",
      "phase": "B",
      "modality": "gallery",
      "when": "category == 'hoodie' && _confidence.subArchetype < 0.6",
      "targets": ["silhouette.fit", "length", "fabric.material", "color.scheme"],
      "priority": 0.95,
      "question": { "de": "Wo fangen wir an?", "en": "Where do we start?" }
    },
    {
      "id": "hoodie_subarch",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'hoodie' && _confidence.subArchetype < 0.6",
      "priority": 0.9,
      "question": {
        "de": "Welcher Hoodie?",
        "en": "Which hoodie?"
      },
      "choices": [
        {
          "id": "pullover",
          "label": {
            "de": "Pullover",
            "en": "Pullover"
          },
          "effects": {
            "set": {
              "subArchetype": "pullover",
              "construction.closure": "none",
              "construction.collar": "hood"
            }
          }
        },
        {
          "id": "zip",
          "label": {
            "de": "Zip-Hoodie",
            "en": "Zip hoodie"
          },
          "effects": {
            "set": {
              "subArchetype": "zip",
              "construction.closure": "zip",
              "construction.collar": "hood"
            },
            "weight": {
              "sport": 0.15,
              "techAvant": 0.1
            }
          }
        },
        {
          "id": "cropped",
          "label": {
            "de": "Cropped",
            "en": "Cropped"
          },
          "effects": {
            "set": {
              "subArchetype": "cropped",
              "length": "cropped"
            },
            "weight": {
              "y2kStreet": 0.2
            }
          }
        },
        {
          "id": "oversized",
          "label": {
            "de": "Oversized",
            "en": "Oversized"
          },
          "effects": {
            "set": {
              "subArchetype": "oversized",
              "silhouette.fit": 0.9,
              "silhouette.volume": "high"
            },
            "weight": {
              "y2kStreet": 0.15
            }
          }
        }
      ]
    },
    {
      "id": "hoodie_fit",
      "phase": "B",
      "modality": "slider",
      "when": "category == 'hoodie' && _confidence.silhouette.fit < 0.7",
      "priority": 0.8,
      "question": {
        "de": "Wie sitzt er?",
        "en": "How does it sit?"
      },
      "bind": "silhouette.fit",
      "axis": {
        "de": [
          "Schmal",
          "Oversized"
        ],
        "en": [
          "Slim",
          "Oversized"
        ]
      },
      "weightAt": {
        "high": {
          "y2kStreet": 0.15
        }
      }
    },
    {
      "id": "hoodie_length",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'hoodie' && _confidence.length < 0.6",
      "priority": 0.7,
      "question": {
        "de": "Wie lang?",
        "en": "How long?"
      },
      "choices": [
        {
          "id": "cropped",
          "label": {
            "de": "Cropped",
            "en": "Cropped"
          },
          "effects": {
            "set": {
              "length": "cropped"
            },
            "weight": {
              "y2kStreet": 0.15
            }
          }
        },
        {
          "id": "regular",
          "label": {
            "de": "Hüfte",
            "en": "Hip"
          },
          "effects": {
            "set": {
              "length": "regular"
            }
          }
        },
        {
          "id": "long",
          "label": {
            "de": "Long",
            "en": "Long"
          },
          "effects": {
            "set": {
              "length": "long"
            }
          }
        }
      ]
    },
    {
      "id": "hoodie_material",
      "phase": "C",
      "modality": "cards",
      "when": "category == 'hoodie' && _confidence.fabric.material < 0.6",
      "priority": 0.72,
      "question": {
        "de": "Aus welchem Stoff?",
        "en": "What fabric?"
      },
      "choices": [
        {
          "id": "fleece",
          "label": {
            "de": "Bio-Fleece",
            "en": "Organic fleece"
          },
          "effects": {
            "set": {
              "fabric.material": "fleece"
            },
            "weight": {
              "sport": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/fleece.jpg"
        },
        {
          "id": "cotton",
          "label": {
            "de": "Schwere Baumwolle",
            "en": "Heavy cotton"
          },
          "effects": {
            "set": {
              "fabric.material": "cotton"
            },
            "weight": {
              "quietMinimal": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/cotton.jpg"
        },
        {
          "id": "polyester",
          "label": {
            "de": "Recycled Tech",
            "en": "Recycled tech"
          },
          "effects": {
            "set": {
              "fabric.material": "polyester",
              "fabric.finish": "matte"
            },
            "weight": {
              "techAvant": 0.15
            }
          },
          "image": "/js/design-engine/content/img/material/polyester.jpg"
        },
        {
          "id": "wool",
          "label": {
            "de": "Merino-Strick",
            "en": "Merino knit"
          },
          "effects": {
            "set": {
              "fabric.material": "wool"
            },
            "weight": {
              "quietMinimal": 0.1,
              "softCouture": 0.1
            }
          },
          "image": "/js/design-engine/content/img/material/wool.jpg"
        }
      ]
    },
    {
      "id": "hoodie_finish",
      "phase": "C",
      "modality": "slider",
      "when": "category == 'hoodie' && _confidence.fabric.finishWeight < 0.6",
      "priority": 0.5,
      "question": { "de": "Matt oder leicht glänzend?", "en": "Matte or slight sheen?" },
      "bind": "fabric.finishWeight",
      "axis": { "de": ["Matt", "Tech-Glanz"], "en": ["Matte", "Tech sheen"] },
      "weightAt": { "high": { "techAvant": 0.15 } }
    },
    {
      "id": "hoodie_sleeve",
      "phase": "B",
      "modality": "cards",
      "when": "category == 'hoodie' && _confidence.construction.sleeve < 0.5",
      "priority": 0.46,
      "question": { "de": "Ärmelschnitt?", "en": "Sleeve cut?" },
      "choices": [
        { "id": "set-in", "label": { "de": "Eingesetzt", "en": "Set-in" }, "effects": { "set": { "construction.sleeve": "set-in" }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "raglan", "label": { "de": "Raglan", "en": "Raglan" }, "effects": { "set": { "construction.sleeve": "raglan" }, "weight": { "sport": 0.15 } } },
        { "id": "drop", "label": { "de": "Drop-Shoulder", "en": "Drop" }, "effects": { "set": { "construction.sleeve": "drop" }, "weight": { "y2kStreet": 0.15 } } }
      ]
    },
    {
      "id": "hoodie_color",
      "phase": "D",
      "modality": "colorGradient",
      "when": "category == 'hoodie' && _confidence.color.scheme < 0.7",
      "priority": 0.78,
      "question": {
        "de": "Welche Farbwelt?",
        "en": "Which colourway?"
      }
    },
    {
      "id": "hoodie_pattern",
      "phase": "D",
      "modality": "cards",
      "when": "category == 'hoodie' && intent.energy > 0.45 && _confidence.pattern.type < 0.6",
      "priority": 0.52,
      "question": { "de": "Print?", "en": "Print?" },
      "choices": [
        { "id": "none", "label": { "de": "Keins", "en": "None" }, "effects": { "set": { "pattern.type": "none" }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "stripe", "label": { "de": "Streifen", "en": "Stripe" }, "effects": { "set": { "pattern.type": "stripe" } } },
        { "id": "graphic", "label": { "de": "Grafik", "en": "Graphic" }, "effects": { "set": { "pattern.type": "graphic" }, "weight": { "y2kStreet": 0.2 } } },
        { "id": "camo", "label": { "de": "Camo", "en": "Camo" }, "effects": { "set": { "pattern.type": "camo" }, "weight": { "utility": 0.15 } } }
      ]
    },
    {
      "id": "hoodie_pattern_scale",
      "phase": "D",
      "modality": "slider",
      "when": "category == 'hoodie' && pattern.type != 'none' && _confidence.pattern.type > 0.5 && _confidence.pattern.scale < 0.6",
      "priority": 0.4,
      "question": { "de": "Wie gross der Print?", "en": "Print scale?" },
      "bind": "pattern.scale",
      "axis": { "de": ["Fein", "Gross"], "en": ["Fine", "Bold"] }
    },
    {
      "id": "hoodie_details",
      "phase": "E",
      "modality": "regions",
      "when": "category == 'hoodie'",
      "priority": 0.5,
      "question": { "de": "Die Details — direkt am Stück", "en": "The details — right on the piece" },
      "regions": [
        {
          "id": "pockets",
          "label": { "de": "Tasche", "en": "Pocket" },
          "choices": [
            { "id": "kangaroo", "label": { "de": "Kängurutasche", "en": "Kangaroo" }, "effects": { "set": { "construction.pockets": "kangaroo" } } },
            { "id": "none", "label": { "de": "Clean", "en": "Clean" }, "effects": { "set": { "construction.pockets": "none" }, "weight": { "quietMinimal": 0.1 } } }
          ]
        },
        {
          "id": "hem",
          "label": { "de": "Saum & Bündchen", "en": "Hem & cuffs" },
          "choices": [
            { "id": "ribbed", "label": { "de": "Gerippt", "en": "Ribbed" }, "effects": { "set": { "construction.hem": "ribbed", "construction.cuffs": "ribbed" } } },
            { "id": "drawcord", "label": { "de": "Kordelzug", "en": "Drawcord" }, "effects": { "set": { "construction.hem": "drawcord" }, "weight": { "sport": 0.1 } } },
            { "id": "straight", "label": { "de": "Gerade", "en": "Straight" }, "effects": { "set": { "construction.hem": "straight" } } }
          ]
        }
      ]
    },
    {
      "id": "hoodie_hardware",
      "phase": "E",
      "modality": "cards",
      "when": "category == 'hoodie' && construction.closure == 'zip' && _confidence.hardware.finish < 0.6",
      "priority": 0.34,
      "question": { "de": "Zipper-Finish?", "en": "Zip finish?" },
      "choices": [
        { "id": "tonal", "label": { "de": "Tonal", "en": "Tonal" }, "effects": { "set": { "hardware.finish": "tonal" } } },
        { "id": "matte", "label": { "de": "Matt-Metall", "en": "Matte metal" }, "effects": { "set": { "hardware.finish": "matte" }, "weight": { "utility": 0.1 } } },
        { "id": "metal", "label": { "de": "Glanz-Metall", "en": "Shiny metal" }, "effects": { "set": { "hardware.finish": "metal" }, "weight": { "y2kStreet": 0.15 } } }
      ]
    },
    {
      "id": "hoodie_signature",
      "phase": "E",
      "modality": "cards",
      "when": "category == 'hoodie' && intent.energy > 0.5 && _confidence.signature < 0.4",
      "priority": 0.3,
      "multi": true,
      "question": { "de": "Signature-Details? Stapelbar.", "en": "Signature details? Stackable." },
      "choices": [
        { "id": "none", "exclusive": true, "label": { "de": "Keins", "en": "None" }, "effects": { "set": { "signature": [] }, "weight": { "quietMinimal": 0.1 } } },
        { "id": "contrast-stitch", "label": { "de": "Kontrastnaht", "en": "Contrast stitch" }, "effects": { "set": { "signature": ["contrast-stitch"] }, "weight": { "utility": 0.1 } } },
        { "id": "branding", "label": { "de": "Branding-Patch", "en": "Branding patch" }, "effects": { "set": { "signature": ["branding-patch"] }, "weight": { "y2kStreet": 0.15, "sport": 0.1 } } }
      ]
    }
  ]
}
